<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Register Sivio deep links and retain the previous app scheme for compatibility -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Sivio Deep Link</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>sivio</string>
        <string>siassist</string>
      </array>
    </dict>
  </array>

  <!-- macOS local-network privacy prompt for LAN API endpoints -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Sivio needs access to your local network to connect to local API endpoints.</string>
</dict>
</plist>
