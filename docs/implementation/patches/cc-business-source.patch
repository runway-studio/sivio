+//! Prepare Keychain items outside the live connection lock, then atomically CAS
+//! the raw rows. Staging imports use their private connection before publication.
+use super::{lock_conn, Database};
+use crate::error::AppError;
+use rusqlite::Connection;
+struct Row {
+    table: &'static str,
+    column: &'static str,
+    id: i64,
+    old: String,
+    text: bool,
+    setting_key: Option<String>,
+}
+pub(super) fn sensitive_setting(key: &str) -> bool {
+    key == "global_proxy_url"
+        || (key.starts_with("common_config_")
+            && !key.ends_with("_cleared")
+            && key != "common_config_legacy_migrated_v1")
+}
+fn snapshot(conn: &Connection) -> Result<Vec<Row>, AppError> {
+    let mut rows = Vec::new();
+    for (table, column, text) in [
+        ("providers", "settings_config", false),
+        ("providers", "meta", false),
+        ("mcp_servers", "server_config", false),
+        ("profiles", "payload", true),
+        ("proxy_live_backup", "original_config", true),
+    ] {
+        let mut stmt = conn
+            .prepare(&format!(
+                "SELECT rowid,{column} FROM {table} WHERE {column} IS NOT NULL"
+            ))
+            .map_err(db_error)?;
+        for row in stmt
+            .query_map([], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, String>(1)?)))
+            .map_err(db_error)?
+        {
+            let (id, old) = row.map_err(db_error)?;
+            rows.push(Row {
+                table,
+                column,
+                id,
+                old,
+                text,
+                setting_key: None,
+            });
+        }
+    }
+    let mut stmt = conn
+        .prepare("SELECT rowid,key,value FROM settings WHERE value IS NOT NULL AND (key IN ('global_proxy_url','universal_providers','si_assist_network') OR substr(key,1,14)='common_config_')")
+        .map_err(db_error)?;
+    for row in stmt
+        .query_map([], |r| {
+            Ok((
+                r.get::<_, i64>(0)?,
+                r.get::<_, String>(1)?,
+                r.get::<_, String>(2)?,
+            ))
+        })
+        .map_err(db_error)?
+    {
+        let (id, key, old) = row.map_err(db_error)?;
+        if sensitive_setting(&key)
+            || ["universal_providers", "si_assist_network"].contains(&key.as_str())
+        {
+            rows.push(Row {
+                table: "settings",
+                column: "value",
+                id,
+                old,
+                text: sensitive_setting(&key),
+                setting_key: Some(key),
+            });
+        }
+    }
+    Ok(rows)
+}
+fn db_error(error: rusqlite::Error) -> AppError {
+    AppError::Database(error.to_string())
+}
+fn prepare(rows: Vec<Row>, validate_references: bool) -> Result<Vec<(Row, String)>, AppError> {
+    let mut updates = Vec::new();
+    for row in rows {
+        let sealed = if row.text {
+            if validate_references {
+                let _ = crate::credential_vault::unprotect_text(&row.old)?;
+            }
+            crate::credential_vault::protect_text(&row.old)?
+        } else {
+            let value:serde_json::Value=serde_json::from_str(&row.old).map_err(|_|AppError::Config(format!("Invalid credential document in {}.{}; restore a valid backup before continuing",row.table,row.column)))?;
+            if validate_references {
+                let _: serde_json::Value = crate::credential_vault::from_str(&row.old)?;
+            }
+            crate::credential_vault::to_string(&value)?
+        };
+        if sealed != row.old {
+            updates.push((row, sealed));
+        }
+    }
+    Ok(updates)
+}
+fn commit(conn: &mut Connection, updates: Vec<(Row, String)>) -> Result<(), AppError> {
+    if updates.is_empty() {
+        return Ok(());
+    }
+    let tx = conn.transaction().map_err(db_error)?;
+    for (row, sealed) in updates {
+        let changed = tx
+            .execute(
+                &format!(
+                    "UPDATE {} SET {}=?1 WHERE rowid=?2 AND {}=?3",
+                    row.table, row.column, row.column
+                ),
+                rusqlite::params![sealed, row.id, row.old],
+            )
+            .map_err(db_error)?;
+        if changed != 1 {
+            return Err(AppError::Database(
+                "Credential migration conflicted with another write; no rows were committed".into(),
+            ));
+        }
+    }
+    tx.commit().map_err(db_error)
+}
+pub(super) fn portable(conn: &mut Connection, include_secrets: bool) -> Result<(), AppError> {
+    let rows = snapshot(conn)?;
+    let mut updates = Vec::new();
+    for row in rows {
+        let mut value = crate::portable_credentials::document(&row.old, row.text, include_secrets)?;
+        if !include_secrets && row.setting_key.as_deref() == Some("si_assist_network") {
+            value = crate::portable_credentials::disable_incomplete_network(&value)?;
+        }
+        updates.push((row, value));
+    }
+    commit(conn, updates)?;
+    if !include_secrets {
+        let endpoints = {
+            let mut stmt = conn
+                .prepare("SELECT id,url FROM provider_endpoints")
+                .map_err(db_error)?;
+            let rows = stmt
+                .query_map([], |row| {
+                    Ok((row.get::<_, i64>(0)?, row.get::<_, String>(1)?))
+                })
+                .map_err(db_error)?;
+            rows.collect::<Result<Vec<_>, _>>().map_err(db_error)?
+        };
+        for (id, url) in endpoints {
+            if crate::portable_credentials::safe_url(&url) == crate::portable_credentials::MISSING {
+                conn.execute("DELETE FROM provider_endpoints WHERE id=?1", [id])
+                    .map_err(db_error)?;
+            }
+        }
+        conn.execute(
+            "UPDATE providers SET is_current=0 WHERE settings_config LIKE ?1 OR meta LIKE ?1",
+            [format!("%{}%", crate::portable_credentials::MISSING)],
+        )
+        .map_err(db_error)?;
+    }
+    Ok(())
+}
+impl Database {
+    pub(crate) fn protect_legacy_credentials(&self) -> Result<(), AppError> {
+        let rows = {
+            let conn = lock_conn!(self.conn);
+            snapshot(&conn)?
+        };
+        // Own immutable references are opened when used. Re-opening every
+        // credential during startup blocks the first paint on Keychain access.
+        // Imports still validate every reference before publishing a snapshot.
+        let updates = prepare(rows, false)?;
+        let mut conn = lock_conn!(self.conn);
+        commit(&mut conn, updates)
+    }
+    pub(super) fn protect_staging_credentials(conn: &mut Connection) -> Result<(), AppError> {
+        let updates = prepare(snapshot(conn)?, true)?;
+        commit(conn, updates)
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn own_reference_does_not_block_startup_but_foreign_import_and_use_fail_explicitly() {
+        let db = Database::memory().unwrap();
+        db.conn.lock().unwrap().execute("INSERT INTO providers(id,app_type,name,settings_config,meta) VALUES('missing','claude','missing',?1,'{}')",[r#"{"env":{"$siCredential":"missing-startup-fixture"}}"#]).unwrap();
+        db.protect_legacy_credentials().unwrap();
+        assert!(db.get_provider_by_id("missing", "claude").is_err());
+        assert!(Database::protect_staging_credentials(&mut db.conn.lock().unwrap()).is_err());
+    }
+    #[test]
+    fn legacy_secret_rows_are_migrated_and_second_run_keeps_references() {
+        let db = Database::memory().unwrap();
+        {
+            let conn = db.conn.lock().unwrap();
+            conn.execute("INSERT INTO providers(id,app_type,name,settings_config,meta) VALUES('fixture','claude','fixture',?1,'{}')",[r#"{"env":{"ANTHROPIC_AUTH_TOKEN":"legacy-fixture-secret"}}"#]).unwrap();
+        }
+        db.protect_legacy_credentials().unwrap();
+        let first: String = db
+            .conn
+            .lock()
+            .unwrap()
+            .query_row(
+                "SELECT settings_config FROM providers WHERE id='fixture'",
+                [],
+                |r| r.get(0),
+            )
+            .unwrap();
+        assert!(!first.contains("legacy-fixture-secret"));
+        assert!(first.contains("$siCredential"));
+        db.protect_legacy_credentials().unwrap();
+        let second: String = db
+            .conn
+            .lock()
+            .unwrap()
+            .query_row(
+                "SELECT settings_config FROM providers WHERE id='fixture'",
+                [],
+                |r| r.get(0),
+            )
+            .unwrap();
+        assert_eq!(first, second);
+        assert_eq!(
+            db.get_provider_by_id("fixture", "claude")
+                .unwrap()
+                .unwrap()
+                .settings_config["env"]["ANTHROPIC_AUTH_TOKEN"],
+            "legacy-fixture-secret"
+        );
+    }
+}
