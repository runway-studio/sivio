+    let expected_skills = super::restore_journal::tree_revision(skills)?;
+    let journal = super::restore_journal::Journal::begin(db, &expected_database, &expected_skills)?;
+    let journal_before = journal.database_before()?;
+    if expected_before.is_some_and(|expected| expected != journal_before) {
+        journal.finish()?;
+        return Err(AppError::Config(
+            "Application data changed after migration preview; review again".into(),
+        ));
+    }
+    let result = super::webdav_sync::archive::restore_skills_directory(skills).and_then(|_| {
+        db.import_configuration_restore(&prepared, &journal_before)
+            .map(|_| ())
+    });
+    if let Err(error) = result {
+        if let Err(rollback) = journal.rollback(db) {
+            return Err(AppError::Config(format!("Restore failed: {error}; rollback requires recovery: {rollback}. The pending restore snapshot was preserved.")));
+        }
+        return Err(error);
+    }
+    if let Err(error) = journal.finish() {
+        journal.rollback(db).map_err(|rollback| {
+            AppError::Config(format!(
