+import { useTranslation } from "react-i18next";
+import { Button } from "@/components/ui/button";
+import { toast } from "@/lib/toast";
+type Source = {
+  kind: "cc-switch" | "clash-verge";
+  filePath: string;
+  available?: boolean;
+  cancelled?: boolean;
+};
+type Preview = Source & {
+  revision: string;
+  replace: boolean;
+  counts: Record<string, { added: number; conflicts: number; kept: number }>;
+  warnings: string[];
+};
