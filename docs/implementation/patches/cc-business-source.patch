+++ app/src-tauri/src/network/profile_enhance.rs
@@ -0,0 +1,185 @@
+//! Global transforms run first; each subscription can add its own isolated
+//! Merge/sequence/script pipeline and choose its DNS override independently.
+use super::{enhance, Settings, LIMIT};
+use anyhow::{ensure, Context, Result};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use serde_yaml_ng::{Mapping, Value as Yaml};
+use std::time::Duration;
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub struct ProfileEnhancement {
+    pub enabled: bool,
+    pub merge: String,
+    pub script: String,
+    pub rules: String,
+    pub proxies: String,
+    pub groups: String,
+    pub dns_mode: String,
+    pub dns: String,
+    // A migrated source-global pipeline stays with its profiles instead of
+    // changing unrelated profiles already managed by SI Assist.
+    pub imported_global: Option<super::Settings>,
+}
+impl Default for ProfileEnhancement {
+    fn default() -> Self {
+        Self {
+            enabled: false,
+            merge: "{}".into(),
+            script: "".into(),
+            rules: "prepend: []\nappend: []\ndelete: []".into(),
+            proxies: "prepend: []\nappend: []\ndelete: []".into(),
+            groups: "prepend: []\nappend: []\ndelete: []".into(),
+            dns_mode: "inherit".into(),
+            dns: "{}".into(),
+            imported_global: None,
+        }
+    }
+}
+fn transform(
+    mut config: Mapping,
+    merge: &str,
+    rules: &str,
+    proxies: &str,
+    groups: &str,
+    script: &str,
+    name: &str,
+) -> Result<Mapping> {
+    for text in [merge, rules, proxies, groups, script] {
+        ensure!(text.len() <= LIMIT, "enhancement exceeds 16 MiB");
+    }
+    let merge: Mapping = serde_yaml_ng::from_str(merge).context("invalid Merge YAML")?;
+    config = enhance::merge::use_merge(&merge, config);
+    for (field, data) in [
+        ("rules", rules),
+        ("proxies", proxies),
+        ("proxy-groups", groups),
+    ] {
+        let seq: enhance::seq::SeqMap = serde_yaml_ng::from_str(data)
+            .with_context(|| format!("invalid {field} enhancement"))?;
+        config = enhance::seq::use_seq(seq, config, field);
+    }
+    if !script.trim().is_empty() {
+        let input = serde_json::to_string(&config)?;
+        ensure!(input.len() <= LIMIT, "script input exceeds 16 MiB");
+        let code = format!(
+            "{script}\nJSON.stringify(main(JSON.parse({}), {}))",
+            serde_json::to_string(&input)?,
+            serde_json::to_string(name)?
+        );
+        let runtime = rquickjs::Runtime::new()?;
+        runtime.set_memory_limit(32 * 1024 * 1024);
+        runtime.set_max_stack_size(256 * 1024);
+        let deadline = std::time::Instant::now() + Duration::from_secs(5);
+        runtime.set_interrupt_handler(Some(Box::new(move || std::time::Instant::now() > deadline)));
+        let context = rquickjs::Context::full(&runtime)?;
+        let output: String = context.with(|ctx| ctx.eval(code))?;
+        ensure!(output.len() <= LIMIT, "script output exceeds 16 MiB");
+        config = serde_json::from_str(&output).context("script must return an object")?;
+    }
+    Ok(config)
+}
+pub fn apply(
+    config: Mapping,
+    global: &Settings,
+    profile: Option<&Value>,
+    name: &str,
+) -> Result<Mapping> {
+    let profile: ProfileEnhancement = profile
+        .map(|value| serde_json::from_value(value.clone()))
+        .transpose()?
+        .unwrap_or_default();
+    ensure!(
+        ["inherit", "profile", "subscription"].contains(&profile.dns_mode.as_str()),
+        "DNS mode must be inherit, profile or subscription"
+    );
+    let subscription_dns = config.get("dns").cloned();
+    let mut config = transform(
+        config,
+        &global.merge,
+        &global.rules,
+        &global.proxies,
+        &global.groups,
+        &global.script,
+        name,
+    )?;
+    if profile.enabled {
+        if let Some(imported) = &profile.imported_global {
+            config = transform(
+                config,
+                &imported.merge,
+                &imported.rules,
+                &imported.proxies,
+                &imported.groups,
+                &imported.script,
+                name,
+            )?;
+        }
+        config = transform(
+            config,
+            &profile.merge,
+            &profile.rules,
+            &profile.proxies,
+            &profile.groups,
+            &profile.script,
+            name,
+        )?;
+    }
+    let dns = match profile.dns_mode.as_str() {
+        "profile" => Some(profile.dns.as_str()),
+        "subscription" => None,
+        _ => Some(global.dns.as_str()),
+    };
+    if let Some(dns) = dns {
+        ensure!(dns.len() <= LIMIT, "DNS settings exceed 16 MiB");
+        let dns: Mapping = serde_yaml_ng::from_str(dns).context("invalid DNS YAML")?;
+        if !dns.is_empty() {
+            config.insert("dns".into(), dns.into());
+        }
+    } else {
+        config.remove("dns");
+        if let Some(dns) = subscription_dns {
+            config.insert(Yaml::from("dns"), dns);
+        }
+    }
+    Ok(config)
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    #[test]
+    fn local_transforms_follow_global_and_subscription_dns_can_be_preserved() {
+        let mut global = Settings::default();
+        global.merge = "future: global\nkeep: true".into();
+        global.dns = "nameserver: [global.invalid]".into();
+        let input: Mapping =
+            serde_yaml_ng::from_str("future: base\ndns: {nameserver: [subscription.invalid]}")
+                .unwrap();
+        let profile = json!({"enabled":true,"merge":"future: local","script":"function main(c,name){c.profileName=name;return c}","dnsMode":"subscription"});
+        let result = apply(input, &global, Some(&profile), "Fixture subscription").unwrap();
+        assert_eq!(result["future"].as_str(), Some("local"));
+        assert_eq!(result["keep"].as_bool(), Some(true));
+        assert_eq!(result["profileName"].as_str(), Some("Fixture subscription"));
+        assert_eq!(
+            result["dns"]["nameserver"][0].as_str(),
+            Some("subscription.invalid")
+        );
+    }
+    #[test]
+    fn disabled_local_pipeline_stays_off_but_dns_choice_remains_independent() {
+        let profile = json!({"enabled":false,"merge":"unexpected: true","dnsMode":"profile","dns":"nameserver: [profile.invalid]"});
+        let result = apply(
+            Mapping::new(),
+            &Settings::default(),
+            Some(&profile),
+            "Fixture",
+        )
+        .unwrap();
+        assert!(!result.contains_key("unexpected"));
+        assert_eq!(
+            result["dns"]["nameserver"][0].as_str(),
+            Some("profile.invalid")
+        );
+    }
+}
--- vendor/upstream/cc-switch/src-tauri/src/network/proxy_guard.rs
+++ app/src-tauri/src/network/proxy_guard.rs
@@ -0,0 +1,160 @@
+//! Best-effort network-service reconciliation. A foreign owner permanently trips this run's guard.
+use super::*;
+#[derive(Default)]
+pub(super) struct Guard {
+    pub last: Option<std::time::Instant>,
+    pub tripped: bool,
+    target: Option<(Duration, ipc::MacosProxyConfig)>,
+}
+impl Guard {
+    pub(super) fn configured(settings: &Settings) -> Self {
+        Self {
+            target: (settings.system_proxy && settings.proxy_guard).then(|| {
+                (
+                    Duration::from_secs(settings.proxy_guard_seconds),
+                    config(settings),
+                )
+            }),
+            ..Default::default()
+        }
+    }
+}
+pub(super) fn config(settings: &Settings) -> ipc::MacosProxyConfig {
+    if settings.proxy_mode == "pac" {
+        ipc::MacosProxyConfig::Pac {
+            url: format!(
+                "http://{}:{}/commands/pac",
+                ipc::proxy_destination::authority(&settings.proxy_host),
+                settings.pac_port
+            ),
+        }
+    } else {
+        ipc::MacosProxyConfig::Global {
+            host: settings.proxy_host.clone(),
+            port: settings.mixed_port,
+            bypass: effective_bypass(settings).into(),
+        }
+    }
+}
+pub(super) fn effective_bypass(settings: &Settings) -> &str {
+    if settings.use_default_bypass {
+        "localhost,127.*,::1"
+    } else {
+        &settings.bypass
+    }
+}
+pub(super) fn validate(settings: &Settings) -> Result<()> {
+    let bypass = effective_bypass(settings);
+    ensure!(
+        bypass.len() <= 8192 && !bypass.contains('\0'),
+        "Proxy bypass is too long or contains NUL"
+    );
+    ensure!(
+        (1..=3600).contains(&settings.proxy_guard_seconds),
+        "Proxy guard interval must be 1–3600 seconds"
+    );
+    if settings.bypass_check {
+        ensure!(
+            bypass.split(',').all(|part| {
+                let part = part.trim();
+                !part.is_empty()
+                    && part
+                        .chars()
+                        .all(|c| c.is_ascii_alphanumeric() || "-._:*?/<>[]".contains(c))
+            }),
+            "Invalid bypass syntax; use comma-separated hosts, wildcards or IP ranges"
+        );
+    }
+    Ok(())
+}
+fn foreign(snapshot: &sysproxy::ProxySnapshot, desired: &ipc::MacosProxyConfig) -> bool {
+    let active = !snapshot.is_all_disabled();
+    active
+        && match desired {
+            ipc::MacosProxyConfig::Global { host, port, bypass } => {
+                !snapshot.matches_global(&sysproxy::Sysproxy {
+                    host: host.clone(),
+                    port: *port,
+                    bypass: bypass.clone(),
+                    enable: true,
+                })
+            }
+            ipc::MacosProxyConfig::Pac { url } => !snapshot.matches_pac(&sysproxy::Autoproxy {
+                url: url.clone(),
+                enable: true,
+            }),
+            _ => true,
+        }
+}
+pub(super) async fn reconcile(runtime: &mut Runtime) {
+    let Some((interval, desired)) = runtime.proxy_guard.target.clone() else {
+        return;
+    };
+    if runtime.phase != "running" || !runtime.managed || runtime.proxy_guard.tripped {
+        return;
+    }
+    if runtime
+        .proxy_guard
+        .last
+        .is_some_and(|at| at.elapsed() < interval)
+    {
+        return;
+    }
+    runtime.proxy_guard.last = Some(std::time::Instant::now());
+    let Some(proof) = runtime.session.as_ref() else {
+        return;
+    };
+    let actual = tauri::async_runtime::spawn_blocking(sysproxy::Sysproxy::snapshot).await;
+    if !matches!(actual,Ok(Ok(ref snapshot)) if !foreign(snapshot,&desired)) {
+        runtime.proxy_guard.tripped = true;
+        runtime.error=Some("System proxy ownership changed or cannot be inspected; guard stopped and existing settings were preserved".into());
+        return;
+    }
+    let result = tokio::time::timeout(
+        Duration::from_secs(3),
+        ipc::set_system_proxy(
+            &match credentials() {
+                Ok(value) => value,
+                Err(_) => return,
+            },
+            proof,
+            &desired,
+        ),
+    )
+    .await;
+    if !matches!(result,Ok(Ok(ref response)) if response.code==0) {
+        // The helper's journal CAS may reject a disabled/external edit. Never
+        // retry after rejection, because its recovery can release that journal.
+        runtime.proxy_guard.tripped = true;
+        runtime.error=Some("System proxy guard could not reconcile ownership; it will not retry until an explicit network restart".into());
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn foreign_proxy_is_never_reclaimed_and_bypass_checks_are_optional_not_unbounded() {
+        let desired = config(&Settings::default());
+        let mut snapshot = sysproxy::ProxySnapshot::default();
+        snapshot.http = sysproxy::ProxyEndpoint {
+            host: "127.0.0.1".into(),
+            port: 7890,
+            enable: true,
+            switched_on: true,
+        };
+        assert!(foreign(&snapshot, &desired));
+        assert!(!foreign(&sysproxy::ProxySnapshot::default(), &desired));
+        let mut settings = Settings {
+            bypass: "bad value".into(),
+            use_default_bypass: false,
+            ..Default::default()
+        };
+        assert!(validate(&settings).is_err());
+        settings.bypass_check = false;
+        assert!(validate(&settings).is_ok());
+        settings.bypass = "x".repeat(8193);
+        assert!(validate(&settings).is_err());
+        settings.use_default_bypass = true;
+        assert!(validate(&settings).is_ok());
+    }
+}
--- vendor/upstream/cc-switch/src-tauri/src/network/repository.rs
+++ app/src-tauri/src/network/repository.rs
@@ -0,0 +1,190 @@
+//! Network configuration shares the AI database transaction/backup boundary.
+//! Values are immutable Keychain references; runtime/lease/helper state is never stored here.
+use super::{digest, Catalog, KEYCHAIN_SERVICE, LIMIT};
+use anyhow::{ensure, Context, Result};
+use once_cell::sync::OnceCell;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::{collections::BTreeMap, sync::Arc};
+pub(crate) const KEY: &str = "si_assist_network";
+static DATABASE: OnceCell<Arc<crate::database::Database>> = OnceCell::new();
+#[derive(Serialize, Deserialize)]
+pub(super) struct Repository {
+    pub(super) schema: u32,
+    pub(super) catalog: Catalog,
+    #[serde(default)]
+    pub(super) payloads: BTreeMap<String, Value>,
+    #[serde(default)]
+    pub(super) custom_proxy: Option<String>,
+    #[serde(default)]
+    pub(super) legacy: Option<Value>,
+}
+pub fn connect(db: Arc<crate::database::Database>) -> Result<()> {
+    DATABASE
+        .set(db)
+        .map_err(|_| anyhow::anyhow!("network repository already connected"))?;
+    if read()?.is_none() {
+        let catalog = super::read_legacy_catalog()?;
+        save(&catalog)?;
+    }
+    Ok(())
+}
+pub fn connected() -> bool {
+    DATABASE.get().is_some()
+}
+fn read() -> Result<Option<(Repository, String)>> {
+    let Some(db) = DATABASE.get() else {
+        return Ok(None);
+    };
+    let Some(raw) = db.get_setting(KEY)? else {
+        return Ok(None);
+    };
+    ensure!(raw.len() <= LIMIT, "network repository exceeds limit");
+    let document: Value = crate::credential_vault::from_str(&raw)?;
+    let record: Repository = serde_json::from_value(
+        document
+            .get("config")
+            .context("invalid network repository")?
+            .clone(),
+    )?;
+    ensure!(
+        record.schema == 1 && record.catalog.schema <= 1,
+        "network schema is newer than supported"
+    );
+    Ok(Some((record, raw)))
+}
+pub fn catalog() -> Result<Option<Catalog>> {
+    Ok(read()?.map(|(record, raw)| {
+        let mut catalog = record.catalog;
+        catalog.storage_revision = Some(digest(raw.as_bytes()));
+        catalog
+    }))
+}
+pub fn payload(key: &str) -> Result<Option<Value>> {
+    Ok(read()?.and_then(|(record, _)| record.payloads.get(key).cloned()))
+}
+pub fn custom(catalog: &Catalog) -> Result<Option<String>> {
+    if let Some((record, _)) = read()? {
+        if record.catalog.custom_proxy_ref == catalog.custom_proxy_ref {
+            return Ok(record.custom_proxy);
+        }
+    }
+    catalog
+        .custom_proxy_ref
+        .as_ref()
+        .map(|key| {
+            security_framework::passwords::get_generic_password(KEYCHAIN_SERVICE, key)
+                .map_err(anyhow::Error::from)
+                .and_then(|bytes| Ok(String::from_utf8(bytes)?))
+        })
+        .transpose()
+}
+pub fn save(catalog: &Catalog) -> Result<()> {
+    let db = DATABASE.get().context("network repository unavailable")?;
+    let previous = read()?;
+    let raw = previous.as_ref().map(|(_, raw)| raw.as_str());
+    ensure!(
+        catalog.storage_revision.as_deref() == raw.map(|raw| digest(raw.as_bytes())).as_deref(),
+        "network configuration changed externally; reload before saving"
+    );
+    let mut payloads = BTreeMap::new();
+    for profile in &catalog.profiles {
+        let key = format!("profile:{}:{}", profile.id, profile.revision);
+        let payload = previous
+            .as_ref()
+            .and_then(|(record, _)| record.payloads.get(&key).cloned());
+        let payload = match payload {
+            Some(payload) => payload,
+            None => super::legacy_secret_get(&key)?,
+        };
+        payloads.insert(key, payload);
+    }
+    // Retain one previous revision until the next commit so failed activation
+    // can roll back even when a portable restore has no legacy Keychain item.
+    if let Some((previous, _)) = &previous {
+        for old in &previous.catalog.profiles {
+            if catalog
+                .profiles
+                .iter()
+                .any(|current| current.id == old.id && current.revision != old.revision)
+            {
+                let key = format!("profile:{}:{}", old.id, old.revision);
+                if let Some(payload) = previous.payloads.get(&key) {
+                    payloads.insert(key, payload.clone());
+                }
+            }
+        }
+    }
+    let custom_proxy = if let Some(key) = &catalog.custom_proxy_ref {
+        if previous
+            .as_ref()
+            .is_some_and(|(record, _)| record.catalog.custom_proxy_ref == catalog.custom_proxy_ref)
+        {
+            previous.as_ref().and_then(|(r, _)| r.custom_proxy.clone())
+        } else {
+            Some(String::from_utf8(
+                security_framework::passwords::get_generic_password(KEYCHAIN_SERVICE, key)?,
+            )?)
+        }
+    } else {
+        None
+    };
+    let record = Repository {
+        schema: 1,
+        catalog: catalog.clone(),
+        payloads,
+        custom_proxy,
+        legacy: previous
+            .as_ref()
+            .and_then(|(record, _)| record.legacy.clone()),
+    };
+    let document = json!({"config":record});
+    ensure!(
+        serde_json::to_vec(&document)?.len() <= LIMIT,
+        "combined network configuration exceeds 16 MiB"
+    );
+    let sealed = crate::credential_vault::to_string(&document)?;
+    db.compare_and_set_setting(KEY, raw, &sealed)?;
+    Ok(())
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn network_data_is_inside_the_same_encrypted_database_snapshot() {
+        let db = crate::database::Database::memory().unwrap();
+        let mut payloads = BTreeMap::new();
+        payloads.insert("profile:fixture:1".into(),json!({"yaml":"proxies: [{name: node,password: fixture-network-password}]","url":"https://example.invalid/private-subscription"}));
+        let record = Repository {
+            schema: 1,
+            catalog: Catalog::default(),
+            payloads,
+            custom_proxy: Some("http://user:fixture-proxy-password@localhost:8888".into()),
+            legacy: None,
+        };
+        let sealed = crate::credential_vault::to_string(&json!({"config":record})).unwrap();
+        db.compare_and_set_setting(KEY, None, &sealed).unwrap();
+        assert!(db.compare_and_set_setting(KEY, None, &sealed).is_err());
+        let raw = db.export_sql_string().unwrap();
+        for secret in [
+            "fixture-network-password",
+            "private-subscription",
+            "fixture-proxy-password",
+        ] {
+            assert!(!raw.contains(secret));
+        }
+        let portable = db.export_portable_sql(false, true).unwrap();
+        for secret in [
+            "fixture-network-password",
+            "private-subscription",
+            "fixture-proxy-password",
+            "$siCredential",
+        ] {
+            assert!(!portable.contains(secret));
+        }
+        assert!(portable.contains("si_assist_network"));
+        assert!(portable.contains(crate::portable_credentials::MISSING));
+        let full = db.export_portable_sql(true, true).unwrap();
+        assert!(full.contains("fixture-network-password"));
+    }
+}
