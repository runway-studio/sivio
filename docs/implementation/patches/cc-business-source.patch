+    match region {
+        Some(region) => UnlockItem::checked_region(PRIME_VIDEO_NAME, "Yes", region),
+        None => UnlockItem::checked(PRIME_VIDEO_NAME, "Failed (PAGE ERROR)", None),
+    }
