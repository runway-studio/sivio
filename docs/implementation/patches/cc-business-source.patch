@@ -0,0 +1,83 @@
+import { useEffect, useState } from "react";
+import { Activity } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import { useNetworkText } from "./networkText";
+/** Explicit paging bounds the DOM; filtering still searches every node in the group. */
+export function ProxyNodeGrid({
+  nodes,
+  current,
+  columns,
+  busy,
+  onSelect,
+  onTest,
+}: {
+  nodes: string[];
+  current: string;
+  columns: number;
+  busy: boolean;
+  onSelect: (node: string) => void;
+  onTest: (node: string) => void;
+}) {
+  const tr = useNetworkText();
+  const [page, setPage] = useState(0);
+  const total = Math.max(1, Math.ceil(nodes.length / 60));
+  const pageIndex = Math.min(page, total - 1);
+  useEffect(() => {
+    setPage(0);
+  }, [nodes.length]);
+  return (
+    <>
+      <div
+        className="grid gap-2"
+        style={{ gridTemplateColumns: `repeat(${columns}, minmax(0, 1fr))` }}
+      >
+        {nodes.slice(pageIndex * 60, pageIndex * 60 + 60).map((node) => (
+          <div
+            key={node}
+            className={`flex min-w-0 items-center gap-1 rounded-lg border px-3 py-2 text-sm ${current === node ? "border-primary/40 bg-primary/5 text-primary" : ""}`}
+          >
+            <button
+              disabled={busy}
+              aria-pressed={current === node}
+              className="min-w-0 flex-1 truncate text-left"
+              onClick={() => onSelect(node)}
+            >
+              {node}
+            </button>
+            <button
+              disabled={busy}
+              aria-label={`${tr("测速")} ${node}`}
+              className="p-1"
+              onClick={() => onTest(node)}
+            >
+              <Activity size={12} />
+            </button>
+          </div>
+        ))}
+      </div>
+      {total > 1 && (
+        <div className="mt-3 flex items-center justify-end gap-3 text-xs">
+          <Button
+            size="sm"
+            variant="outline"
+            disabled={pageIndex === 0}
+            onClick={() => setPage(pageIndex - 1)}
+          >
+            {tr("上一页")}
+          </Button>
+          <span>
+            {pageIndex + 1} / {total} · {nodes.length}
+          </span>
+          <Button
+            size="sm"
+            variant="outline"
+            disabled={pageIndex === total - 1}
+            onClick={() => setPage(pageIndex + 1)}
+          >
+            {tr("下一页")}
+          </Button>
+        </div>
+      )}
+    </>
+  );
+}
