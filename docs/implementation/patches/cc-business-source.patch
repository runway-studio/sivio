+            Ok(
+                json!({"traffic":traffic?,"memory":memory?,"generation":runtime.generation,"sampledAt":chrono::Utc::now().timestamp_millis()}),
+            )
+        }
+        "migration.scan" => Ok(crate::services::legacy_migration::scan()),
+        "migration.choose" => {
