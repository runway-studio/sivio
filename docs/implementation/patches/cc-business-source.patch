+        }
+        let snapshot = job.snapshot();
+        let items = snapshot["items"].as_array().unwrap();
+        assert_eq!(items.len(), 12);
+        assert!(items
+            .iter()
+            .all(|i| i["status"] != "Pending" && i["status"] != "Yes"));
+        job = MediaJob::start(port, None).unwrap();
+        job.cancel();
