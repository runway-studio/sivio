+use serde_json::{json, Value};
+const SERVICE: &str = "local.siassist.desktop.credentials";
+fn protected_key(key: &str) -> bool {
+    if ["authBinding", "authProvider"].contains(&key) {
+        return false;
+    }
+    let key = key.to_ascii_lowercase().replace(['_', '-'], "");
+    if ["syncincludesecrets", "syncrememberpassword"].contains(&key.as_str()) {
+        return false;
+    }
+    [
+        "apikey",
+        "token",
+        "password",
+        "secret",
+        "authorization",
+        "credential",
+        "auth",
+    ]
+    .iter()
+    .any(|part| key.contains(part))
+        || [
+            "env",
+            "config",
+            "code",
+            "args",
+            "originalconfig",
+            "headers",
+            "header",
+            "command",
+        ]
+        .contains(&key.as_str())
+        || key.ends_with("url")
+}
+#[cfg(not(test))]
+fn write(value: &[u8]) -> Result<String, AppError> {
+    let id = uuid::Uuid::new_v4().to_string();
+    security_framework::passwords::set_generic_password(SERVICE, &id, value).map_err(|_| {
+        AppError::Config("macOS Keychain write failed; no plaintext fallback was used".into())
