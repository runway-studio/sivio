+import { useEffect, useState } from "react";
+import { invoke } from "@tauri-apps/api/core";
+import { useQuery } from "@tanstack/react-query";
+import { useWorkspacePreferences } from "@/lib/desktopPreferences";
+import { useTranslation } from "react-i18next";
+type Sample = {
+  sampledAt: number;
+  generation: number;
+  traffic: { up: number; down: number; upTotal: number; downTotal: number };
+  memory: { inuse: number };
+};
+export function appendTraffic(history: Sample[], sample: Sample): Sample[] {
+  if (history.at(-1)?.generation !== sample.generation) return [sample];
+  if ((history.at(-1)?.sampledAt ?? 0) >= sample.sampledAt) return history;
+  return [...history.slice(-59), sample];
+}
+function bytes(value: number | undefined) {
+  if (value === undefined || !Number.isFinite(value)) return "—";
+  const units = ["B", "KiB", "MiB", "GiB", "TiB"];
+  let index = 0;
+  while (value >= 1024 && index < units.length - 1) {
+    value /= 1024;
+    index++;
+  }
+  return `${value.toFixed(index ? 1 : 0)} ${units[index]}`;
+}
+export function NetworkTrafficPanel({
+  running,
+  generation,
+}: {
+  running: boolean;
+  generation: number;
+}) {
+  const { i18n } = useTranslation();
+  const zh = i18n.language.startsWith("zh");
+  const preferences = useWorkspacePreferences();
+  const [history, setHistory] = useState<Sample[]>([]);
+  const query = useQuery({
+    queryKey: ["network", "metrics", generation],
+    enabled: running,
+    queryFn: () =>
+      invoke<Sample>("network_command", { action: "metrics", args: {} }),
+    refetchInterval: 1000,
+    refetchIntervalInBackground: !preferences.pauseTrafficOnBlur,
+    retry: 1,
+  });
+  useEffect(() => {
+    if (!running) setHistory([]);
+    else if (query.data?.generation === generation)
+      setHistory((previous) => appendTraffic(previous, query.data!));
+  }, [running, generation, query.data]);
+  const latest =
+    running && !query.isError && query.data?.generation === generation
+      ? query.data
+      : undefined;
+  const max = Math.max(
+    1,
+    ...history.flatMap((sample) => [sample.traffic.up, sample.traffic.down]),
+  );
+  const points = (direction: "up" | "down") =>
+    history
+      .map(
+        (sample, index) =>
+          `${(index / 59) * 600},${100 - (sample.traffic[direction] / max) * 96}`,
+      )
+      .join(" ");
+  return (
+    <section className="space-y-4">
+      <div className="grid gap-3 sm:grid-cols-3">
+        {[
+          [zh ? "上传速度" : "Upload rate", `${bytes(latest?.traffic.up)}/s`],
+          [
+            zh ? "下载速度" : "Download rate",
+            `${bytes(latest?.traffic.down)}/s`,
+          ],
+          [zh ? "内核内存" : "Core memory", bytes(latest?.memory.inuse)],
+        ]
+          .filter((_, index) => index !== 2 || preferences.memoryUsage)
+          .map(([title, value]) => (
+            <div key={title} className="rounded-xl border bg-card p-4">
+              <p className="text-xs text-muted-foreground">{title}</p>
+              <p className="mt-2 text-xl font-semibold tabular-nums">{value}</p>
+            </div>
+          ))}
+      </div>
+      {preferences.trafficGraph && (
+        <div
+          className={`rounded-xl border bg-card p-5 ${query.isError ? "opacity-50" : ""}`}
+        >
+          <p className="mb-4 text-sm">
+            {zh
+              ? "实时流量 · 最近 60 次采样"
+              : "Live traffic · last 60 samples"}
+          </p>
+          <svg
+            role="img"
+            aria-label={
+              zh ? "上传与下载速度趋势" : "Upload and download rate history"
+            }
+            viewBox="0 0 600 104"
+            className="h-40 w-full"
+            preserveAspectRatio="none"
+          >
+            <line x1="0" y1="100" x2="600" y2="100" className="stroke-border" />
+            <polyline
+              fill="none"
+              stroke="currentColor"
+              strokeWidth="2"
+              points={points("up")}
+              className="text-primary"
+            />
+            <polyline
+              fill="none"
+              stroke="currentColor"
+              strokeWidth="2"
+              points={points("down")}
+              className="text-emerald-500"
+            />
+          </svg>
+          <div className="mt-3 flex flex-wrap gap-5 text-xs text-muted-foreground">
+            <span className="text-primary">
+              ↑ {zh ? "累计上传" : "Uploaded"} {bytes(latest?.traffic.upTotal)}
+            </span>
+            <span className="text-emerald-600">
+              ↓ {zh ? "累计下载" : "Downloaded"}{" "}
+              {bytes(latest?.traffic.downTotal)}
+            </span>
+          </div>
+        </div>
+      )}
+      <p
+        role={query.isError ? "alert" : "status"}
+        className={`text-xs ${query.isError ? "text-destructive" : "text-muted-foreground"}`}
+      >
+        {!running
+          ? zh
+            ? "内核已停止，采样已暂停"
+            : "Core stopped; sampling paused"
+          : query.isError
+            ? zh
+              ? "数据已过期，正在尝试重新连接"
+              : "Data is stale; reconnecting"
+            : latest
+              ? zh
+                ? "仅统计当前内核运行，不重复累加历史采样。离开页面后停止采样。"
+                : "Totals belong to this core run and do not accumulate sampled history. Sampling stops when you leave this view."
+              : zh
+                ? "正在等待内核流量数据…"
+                : "Waiting for core metrics…"}
+      </p>
+    </section>
+  );
+}
