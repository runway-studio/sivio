+              setPreview(null);
+            }}
+          >
+            <option value="cc-switch">CC Switch</option>
+            <option value="clash-verge">Clash Verge Rev</option>
+          </select>
+        </label>
+        <label className="flex items-center gap-2 text-xs">
+          <input
+            type="checkbox"
