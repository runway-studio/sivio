+        return Err(AppError::Config(
+            "Preference file changed externally; cleanup deferred".into(),
+        ));
+    }
+    crate::config::atomic_write_private(
+        path,
+        serde_json::to_string_pretty(&raw)
+            .map_err(|e| AppError::Config(e.to_string()))?
+            .as_bytes(),
+    )
