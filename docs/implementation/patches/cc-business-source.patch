+fn appearance_reset_label(texts: &TrayTexts) -> &'static str {
+    match texts.open_website {
+        "关于 SI Assist" => "恢复默认外观",
+        "關於 SI Assist" => "恢復預設外觀",
+        "SI Assist について" => "外観をリセット",
+        "SI Assist Hakkında" => "Görünümü sıfırla",
+        _ => "Reset appearance",
+    }
+}
+#[cfg(target_os = "macos")]
+fn update_main_tools(app: &tauri::AppHandle, texts: &TrayTexts) -> Result<(), AppError> {
+    let Some(menu) = app.menu() else {
+        return Ok(());
+    };
+    let Some(MenuItemKind::Submenu(tools)) = menu.get("si-assist-tools") else {
+        return Ok(());
+    };
+    tools
+        .set_text(match texts.open_website {
+            "关于 SI Assist" => "工具",
+            "關於 SI Assist" => "工具",
+            "SI Assist について" => "ツール",
+            "SI Assist Hakkında" => "Araçlar",
+            _ => "Tools",
+        })
+        .map_err(menu_error)?;
+    for (id, label) in [
+        ("lightweight_mode", texts.lightweight_mode),
+        ("reset_appearance", appearance_reset_label(texts)),
+    ] {
+        if let Some(MenuItemKind::MenuItem(item)) = tools.get(id) {
+            item.set_text(label).map_err(menu_error)?;
+        }
+    }
+    if let Some(old) = tools.get("nav:page:network") {
+        tools.remove(&old).map_err(menu_error)?;
+    }
+    if let Some(old) = tools.get("si-network-main") {
+        tools.remove(&old).map_err(menu_error)?;
+    }
+    let mut entry = network_menu(texts, &crate::desktop_preferences::current(app));
+    if let TrayEntry::Submenu { id, .. } = &mut entry {
+        *id = "si-network-main".into();
+    }
+    if let Some(item) = attach_entry(app, &entry, &mut HashMap::new())? {
+        tools.insert(&item, 0).map_err(menu_error)?;
+    }
+    Ok(())
+}
+
+fn menu_label(text: &str) -> String {
+    text.chars().filter(|c| !c.is_control()).take(100).collect()
+}
+fn network_menu(
+    texts: &TrayTexts,
+    preferences: &crate::desktop_preferences::Preferences,
+) -> TrayEntry {
+    let zh = ["关于 SI Assist", "關於 SI Assist"].contains(&texts.open_website);
+    let copy = |cn: &str, en: &str| if zh { cn.to_owned() } else { en.to_owned() };
+    let snapshot = crate::network::tray_bridge::cached();
+    let mut children = vec![
+        TrayEntry::item(
+            "nav:page:network",
+            copy("打开网络工作区", "Open network workspace"),
+        ),
+        TrayEntry::Separator,
+    ];
+    let stop = snapshot.running || snapshot.phase == "failed";
+    children.push(TrayEntry::Item {
+        id: if stop {
+            "network:stop"
+        } else {
+            "network:start"
+        }
+        .into(),
+        text: if stop {
+            copy("停止并恢复网络", "Stop and restore network")
+        } else {
+            copy("启动网络", "Start network")
+        },
+        enabled: stop || snapshot.selected_profile,
+    });
+    let mut modes = Vec::new();
+    for (mode, cn, en) in [
+        ("rule", "规则模式", "Rule mode"),
+        ("global", "全局模式", "Global mode"),
+        ("direct", "直连模式", "Direct mode"),
+    ] {
+        modes.push(TrayEntry::check(
+            format!("network:action:clash_mode_{mode}"),
+            copy(cn, en),
+            snapshot.selected_profile,
+            snapshot.mode == mode,
+        ));
+    }
+    if preferences.tray_inline_modes {
+        children.extend(modes);
+    } else {
+        children.push(TrayEntry::Submenu {
+            id: "network:modes".into(),
+            text: copy("出站模式", "Outbound mode"),
+            app: None,
+            children: modes,
+        });
+    }
+    children.push(TrayEntry::check(
+        "network:action:toggle_system_proxy",
+        copy("系统代理", "System proxy"),
+        snapshot.selected_profile,
+        snapshot.system_proxy,
+    ));
+    children.push(TrayEntry::check(
+        "network:action:toggle_tun_mode",
+        copy("TUN 模式", "TUN mode"),
+        snapshot.selected_profile,
+        snapshot.tun,
+    ));
+    if !snapshot.profiles.is_empty() {
+        children.push(TrayEntry::Separator);
+        for (index, profile) in snapshot.profiles.iter().enumerate() {
+            children.push(TrayEntry::check(
+                format!("network:profile:{}:{index}", snapshot.revision),
+                menu_label(&profile.name),
+                snapshot.phase == "stopped",
+                profile.selected,
+            ));
+        }
+        if snapshot.more_profiles {
+            children.push(TrayEntry::item(
+                "nav:page:network",
+                copy("更多订阅…", "More profiles…"),
+            ));
+        }
+    }
+    let mut group_entries = Vec::new();
+    for (group_index, group) in snapshot.groups.iter().enumerate() {
+        let mut nodes = group
+            .nodes
+            .iter()
+            .enumerate()
+            .map(|(node_index, node)| {
+                TrayEntry::check(
+                    format!(
+                        "network:node:{}:{group_index}:{node_index}",
+                        snapshot.revision
+                    ),
+                    menu_label(node),
+                    snapshot.running,
+                    node == &group.selected,
+                )
+            })
+            .collect::<Vec<_>>();
+        if group.more {
+            nodes.push(TrayEntry::item(
+                "nav:page:network",
+                copy("在工作区查看全部节点…", "View all nodes in workspace…"),
+            ));
+        }
+        group_entries.push(TrayEntry::Submenu {
+            id: format!("network:group:{group_index}"),
+            text: menu_label(&format!("{} · {}", group.name, group.selected)),
+            app: None,
+            children: nodes,
+        });
+    }
+    if snapshot.more_groups {
+        group_entries.push(TrayEntry::item(
+            "nav:page:network",
+            copy("更多分组…", "More groups…"),
+        ));
+    }
+    match preferences.tray_groups_mode.as_str() {
+        "inline" => children.extend(group_entries),
+        "default" if !group_entries.is_empty() => children.push(TrayEntry::Submenu {
+            id: "network:groups".into(),
+            text: copy("代理组", "Proxy groups"),
+            app: None,
+            children: group_entries,
+        }),
+        _ => {}
+    }
+    TrayEntry::Submenu {
+        id: "si-network".into(),
+        text: copy("网络", "Network"),
+        app: None,
+        children,
+    }
+}
