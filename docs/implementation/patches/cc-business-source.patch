+#[cfg(not(test))]
+fn read(id: &str) -> Result<Vec<u8>, AppError> {
+    security_framework::passwords::get_generic_password(SERVICE, id).map_err(|_| {
+        AppError::Config(
+            "credential unavailable in macOS Keychain; restore or re-enter it before use".into(),
+        )
+    })
+}
