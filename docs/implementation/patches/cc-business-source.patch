+        <input
+          type="checkbox"
+          checked={include}
+          onChange={(e) => setInclude(e.target.checked)}
+        />
+        {zh
+          ? "包含凭据，并在上传前加密整个快照"
+          : "Include credentials and encrypt the snapshot before upload"}
+      </label>
+      <Input
