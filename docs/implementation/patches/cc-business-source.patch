+
+/// A live renderer owns drafts and pending operations. It must acknowledge the
+/// request before its webview can be destroyed. No listener means no destruction.
+pub fn request_lightweight_mode(app: &tauri::AppHandle) -> Result<(), String> {
+    if let Some(window) = app.get_webview_window("main") {
+        let _ = window.show();
+        let _ = window.set_focus();
+        window
+            .emit(
+                "lightweight-requested",
+                serde_json::json!({"automatic":false}),
+            )
+            .map_err(|e| e.to_string())
+    } else {
+        enter_lightweight_mode(app)
+    }
+}
+
+pub fn request_automatic_lightweight_mode(app: &tauri::AppHandle) -> Result<(), String> {
+    if let Some(window) = app.get_webview_window("main") {
+        window
+            .emit(
+                "lightweight-requested",
+                serde_json::json!({"automatic":true}),
+            )
+            .map_err(|e| e.to_string())
+    } else {
+        Ok(())
+    }
+}
 
