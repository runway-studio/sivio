+fn seal(value: Value) -> Result<Value, AppError> {
+    match value {
+        Value::Object(mut map) => {
+            if map.len() == 1 && map.contains_key("$siCredential") {
+                return Ok(Value::Object(map));
+            }
+            for (key, value) in map.iter_mut() {
+                if value.as_object().is_some_and(|map| {
+                    map.len() == 1 && map.get("$siCredential").and_then(Value::as_str).is_some()
+                }) {
+                    continue;
+                }
+                if protected_key(key)
+                    && !value.is_null()
+                    // Policy/capability switches are not credentials. Sealing
+                    // auth-related booleans made ordinary preferences require
+                    // a blocking Keychain request during tray initialization.
+                    && !value.is_boolean()
+                    && value.as_str() != Some("")
+                    && !value.as_object().is_some_and(|v| v.is_empty())
+                    && !value.as_array().is_some_and(|v| v.is_empty())
+                {
+                    let bytes =
+                        serde_json::to_vec(value).map_err(|e| AppError::Config(e.to_string()))?;
+                    let id = write(&bytes)?;
+                    *value = json!({"$siCredential":id});
+                } else {
+                    *value = seal(value.take())?;
+                }
+            }
+            Ok(Value::Object(map))
+        }
+        Value::Array(values) => Ok(Value::Array(
+            values.into_iter().map(seal).collect::<Result<_, _>>()?,
+        )),
+        other => Ok(other),
+    }
+}
+fn open(value: Value) -> Result<Value, AppError> {
+    match value {
+        Value::Object(mut map) => {
+            if map.len() == 1 {
+                if let Some(id) = map.get("$siCredential").and_then(Value::as_str) {
+                    let bytes = read(id)?;
+                    return serde_json::from_slice(&bytes).map_err(|_| {
+                        AppError::Config("Keychain credential has invalid format".into())
+                    });
+                }
+            }
+            for value in map.values_mut() {
+                *value = open(value.take())?;
+            }
+            Ok(Value::Object(map))
+        }
+        Value::Array(values) => Ok(Value::Array(
+            values.into_iter().map(open).collect::<Result<_, _>>()?,
+        )),
+        other => Ok(other),
+    }
+}
+pub fn to_string<T: Serialize>(value: &T) -> Result<String, AppError> {
+    let value = serde_json::to_value(value).map_err(|e| AppError::Config(e.to_string()))?;
+    serde_json::to_string(&seal(value)?).map_err(|e| AppError::Config(e.to_string()))
+}
+pub fn from_str<T: DeserializeOwned>(value: &str) -> Result<T, AppError> {
+    let value: Value = serde_json::from_str(value)
+        .map_err(|_| AppError::Config("invalid persisted credential document".into()))?;
+    serde_json::from_value(open(value)?)
+        .map_err(|_| AppError::Config("invalid persisted credential structure".into()))
+}
+pub fn from_sql<T: DeserializeOwned>(value: &str) -> Result<T, rusqlite::Error> {
+    from_str(value).map_err(|e| {
+        rusqlite::Error::FromSqlConversionFailure(0, rusqlite::types::Type::Text, Box::new(e))
+    })
+}
+/// Preserve exact snapshot text while keeping it out of SQL/backups.
+pub fn protect_text(value: &str) -> Result<String, AppError> {
+    if let Ok(document) = serde_json::from_str::<Value>(value) {
+        if document.get("$siProtectedText").and_then(Value::as_u64) == Some(1)
+            && document
+                .get("config")
+                .and_then(Value::as_object)
+                .is_some_and(|m| {
+                    m.len() == 1 && m.get("$siCredential").and_then(Value::as_str).is_some()
+                })
+        {
+            return Ok(value.into());
+        }
+    }
+    to_string(&json!({"$siProtectedText":1,"config":value}))
+}
+pub fn unprotect_text(value: &str) -> Result<String, AppError> {
+    let document = serde_json::from_str::<Value>(value).ok();
+    if document
+        .as_ref()
+        .and_then(|v| v.get("$siProtectedText"))
+        .and_then(Value::as_u64)
+        != Some(1)
+    {
+        return Ok(value.into());
+    }
+    let opened: Value = from_str(value)?;
+    opened
+        .get("config")
+        .and_then(Value::as_str)
+        .map(str::to_owned)
+        .ok_or_else(|| AppError::Config("invalid protected text document".into()))
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn policy_booleans_remain_plain_while_actual_credentials_are_sealed() {
+        let value = json!({"preserveCodexOfficialAuthOnSwitch":false,"authorizationSupported":true,"password":"fixture-policy-password"});
+        let sealed = to_string(&value).unwrap();
+        let document: Value = serde_json::from_str(&sealed).unwrap();
+        assert_eq!(document["preserveCodexOfficialAuthOnSwitch"], false);
+        assert_eq!(document["authorizationSupported"], true);
+        assert!(!sealed.contains("fixture-policy-password"));
+        assert_eq!(from_str::<Value>(&sealed).unwrap(), value);
+    }
+    #[test]
+    fn secrets_are_references_and_unknown_fields_round_trip() {
+        let original = json!({"env":{"ANTHROPIC_AUTH_TOKEN":"fixture-only-key","FUTURE_FIELD":7},"config":"api_key='fixture-toml-key'","opaque":{"apiKey":"fixture-usage-key","future":true},"name":"demo"});
+        let encoded = to_string(&original).unwrap();
+        assert!(!encoded.contains("fixture-"));
+        assert!(encoded.contains("$siCredential"));
+        let decoded: Value = from_str(&encoded).unwrap();
+        assert_eq!(decoded, original);
+    }
+    #[test]
+    fn unavailable_reference_is_a_visible_error() {
+        let encoded = r#"{"apiKey":{"$siCredential":"missing-fixture"}}"#;
+        assert!(from_str::<Value>(encoded).is_err());
+    }
+    #[test]
+    fn legacy_json_can_be_read_and_resealed() {
+        let legacy = r#"{"auth":{"api_key":"fixture-only"},"unknown":4}"#;
+        let decoded: Value = from_str(legacy).unwrap();
+        let encoded = to_string(&decoded).unwrap();
+        assert!(!encoded.contains("fixture-only"));
+        assert_eq!(from_str::<Value>(&encoded).unwrap(), decoded);
+    }
+}
