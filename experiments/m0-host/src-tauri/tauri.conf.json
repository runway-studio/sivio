{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SI Assist M0",
  "version": "0.1.0",
  "identifier": "local.siassist.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SI Assist · M0 集成验证",
        "width": 1060,
        "height": 820,
        "minWidth": 800,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../../../build/cache/mihomo/aarch64-apple-darwin/stable/mihomo": "bin/mihomo",
      "../licenses/": "licenses/",
      "../SOURCE-NOTICE.md": "SOURCE-NOTICE.md"
    }
  }
}
